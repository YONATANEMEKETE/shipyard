
# API
NODE_ENV=development
API_PORT=4000
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=30000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=30
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
LOG_LEVEL=info
DATABASE_URL=postgresql://shipyard:shipyard@localhost:5433/shipyard
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Auth — OAuth providers (F1 Phase 2). A provider activates only when both
# values are set. Callback URLs to register in each console:
#   dev:  http://localhost:3000/api/v1/auth/callback/<provider>
#   prod: https://shipyard.yonatanem.com/api/v1/auth/callback/<provider>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Auth — email delivery (F1 Phase 2). Until RESEND_API_KEY is set, auth
# emails run in dev inbox mode (logged, not sent).
# RESEND_API_KEY=
# EMAIL_FROM=Shipyard <noreply@yonatanem.com>
