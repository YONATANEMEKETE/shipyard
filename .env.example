
# API
NODE_ENV=development
API_PORT=4000
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=30000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=120
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
LOG_LEVEL=info
DATABASE_URL=postgresql://shipyard:shipyard@localhost:5433/shipyard
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Auth — OAuth providers (F1 Phase 2). Required — fail-fast at startup.
# Callback URLs to register in each console:
#   dev:  http://localhost:3000/api/v1/auth/callback/<provider>
#   prod: https://shipyard.yonatanem.com/api/v1/auth/callback/<provider>
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# Auth — email delivery (F1 Phase 2). Required — fail-fast at startup.
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Shipyard <noreply@yonatanem.com>
