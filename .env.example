
# API
NODE_ENV=development
API_PORT=4000
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=30000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=30
# Public origins. Production values:
#   API_URL=https://api.shipyard.yonatanem.com  (Better Auth baseURL, OAuth redirects)
#   WEB_URL=https://shipyard.yonatanem.com      (email links, trusted browser origin)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Additional browser origins allowed to call the API cross-origin (CORS +
# Better Auth trustedOrigins). Comma-separated; WEB_URL is always allowed.
# Used for Vercel preview deployments.
EXTRA_TRUSTED_ORIGINS=
# Session-cookie sharing across the web and API hosts. Production:
# COOKIE_DOMAIN=yonatanem.com (the cookie then reaches both shipyard.… and
# api.shipyard.…). Leave empty in dev — localhost cookies already ignore ports.
COOKIE_DOMAIN=
LOG_LEVEL=info
DATABASE_URL=postgresql://shipyard:shipyard@localhost:5433/shipyard
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=Shipyard <no-reply@yonatanem.com>

# R2 public asset storage (S3-compatible; settings F11)
# shipyard-bucket is PUBLIC-READ by design — only non-secret, unguessable-key
# objects (avatars/, ...) belong in it. Private data needs its own bucket.
# R2_ENDPOINT: S3 endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PUBLIC_BUCKET=shipyard-bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL of the bucket for reading objects, e.g. https://pub-<id>.r2.dev
R2_PUBLIC_BASE_URL=

# Error monitoring (Sentry). Optional — empty means the SDK is disabled and
# sends nothing (tests and local dev stay silent). One Sentry project per app
# (api / web): this is the API project's; the web app uses its own var.
# Render holds the production value.
SENTRY_API_DSN=

# Release tag attached to every event. Render sets the value from the deploy's
# commit SHA automatically (RENDER_GIT_COMMIT), so leave this empty there; set
# it only on hosts that expose no commit SHA.
SENTRY_RELEASE=

# Product analytics (PostHog). Optional — with no token the reporter is a
# no-op that sends nothing, so tests and local development stay silent.
# POSTHOG_HOST is the ingestion origin, not the dashboard URL (`us.posthog.com`).
# Render holds the production values.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
