// Prisma schema — Shipyard API
// Connection URL lives in prisma.config.ts (Prisma 7 pattern), not here.
// Models are added with the first feature build (see
// shipyard-design/04-Engineering/features/*/02-data-model.md).

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

model User {
  id                    String            @id
  name                  String
  email                 String
  emailVerified         Boolean           @default(false)
  image                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  sessions              Session[]
  accounts              Account[]
  workspaceMembers      WorkspaceMember[]
  sentInvitations       Invitation[]      @relation("CreatedInvitations")
  ownedProjects         Project[]
  viewPreferences       ViewPreference[]
  assignedIssues        Issue[]           @relation("AssignedIssues")
  createdIssues         Issue[]           @relation("CreatedIssues")
  issueHistoryActions   IssueHistory[]
  authoredComments      Comment[]         @relation("AuthoredComments")
  commentMentions       CommentMention[]  @relation("CommentMentions")
  receivedNotifications Notification[]    @relation("ReceivedNotifications")
  sentNotifications     Notification[]    @relation("SentNotifications")
  activityActions       ActivityEvent[]
  issueViews            IssueView[]
  preference            UserPreference?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── Workspace (F2) ───────────────────────────────────────────────────────────
// Prisma-owned (hand-modeled, unlike F1's Better Auth tables). Follows Better
// Auth conventions. See shipyard-design/04-Engineering/features/workspace/data-model.md.

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  DECLINED
  EXPIRED
}

model Workspace {
  id         String          @id @default(cuid())
  name       String          @db.VarChar(80)
  slug       String          @unique
  status     WorkspaceStatus @default(ACTIVE)
  icon       String?         @db.VarChar(32)
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  members         WorkspaceMember[]
  invitations     Invitation[]
  projects        Project[]
  viewPreferences ViewPreference[]
  issues          Issue[]
  labels          Label[]
  issueHistories  IssueHistory[]
  issueSequence   WorkspaceIssueSequence?
  cycles          Cycle[]
  comments        Comment[]
  notifications   Notification[]
  activityEvents  ActivityEvent[]
  issueViews      IssueView[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_member")
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String           @db.VarChar(320)
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CreatedInvitations", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([expiresAt])
  @@index([createdById])
  @@map("invitation")
}

// ── Projects (F4) ───────────────────────────────────────────────────────────
// Prisma-owned (hand-modeled, like workspace/members). See
// shipyard-design/04-Engineering/features/projects/data-model.md §2.

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

// Generic per-user-per-workspace, per-entity List/Kanban choice (rule 12).
// PROJECT shipped in F4; F5 widens additively with ISSUE.
enum ViewScope {
  PROJECT
  ISSUE
}

enum ViewType {
  LIST
  KANBAN
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String        @db.VarChar(120)
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  ownerId     String
  archivedAt  DateTime?
  startDate   DateTime?     @db.Date
  targetDate  DateTime?     @db.Date
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // F10 search (D2): generated tsvector column — see Issue.search_tsv.
  // A-weight = name.
  search_tsv  Unsupported("tsvector") @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, (COALESCE(name, ''::character varying))::text), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  issues    Issue[]

  // D3: case-insensitive, workspace-scoped name uniqueness is a raw SQL
  // functional index (project_name_unique) appended to the migration.
  @@index([workspaceId])
  @@index([status])
  @@index([ownerId])
  @@index([archivedAt])
  @@index([search_tsv], type: Gin, map: "project_search_gin")
  @@map("project")
}

// ── Issues + Labels (F5) ───────────────────────────────────────────────────
// Prisma-owned (hand-modeled, like workspace/members/projects). See
// shipyard-design/04-Engineering/features/issues/data-model.md §2.

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

enum IssuePriority {
  NO_PRIORITY
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum IssueHistoryEvent {
  CREATED
  STATUS_CHANGED
  BLOCKED_SET
  BLOCKED_CLEARED
  ASSIGNED
  UNASSIGNED
  PRIORITY_CHANGED
  PROJECT_CHANGED
  DUE_DATE_CHANGED
  TITLE_CHANGED
  ARCHIVED
  RESTORED
  LABEL_ADDED
  LABEL_REMOVED
  CYCLE_CHANGED
}

model Issue {
  id            String        @id @default(cuid())
  workspaceId   String
  seqNumber     Int
  title         String        @db.VarChar(255)
  description   String?       @db.Text
  status        IssueStatus   @default(BACKLOG)
  priority      IssuePriority @default(NO_PRIORITY)
  assigneeId    String?
  creatorId     String
  projectId     String?
  cycleId       String?
  dueDate       DateTime?     @db.Date
  blocked       Boolean       @default(false)
  blockedReason String?       @db.VarChar(500)
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // F10 search (D2): generated tsvector column, owned by the raw-SQL
  // migration append. Declared as Unsupported so Prisma Client never
  // surfaces it — the application never reads or writes this column through
  // Prisma; ranked reads go through typed $queryRaw in features/search.
  // The @default(dbgenerated(...)) mirrors the STORED generation expression
  // verbatim (as `prisma db pull` introspects it) so `migrate dev`'s drift
  // detection sees schema and database as identical instead of emitting a
  // DROP DEFAULT that Postgres rejects on generated columns.
  search_tsv    Unsupported("tsvector") @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, (COALESCE(title, ''::character varying))::text), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator   User      @relation("CreatedIssues", fields: [creatorId], references: [id], onDelete: Restrict)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cycle     Cycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  labels        IssueLabel[]
  history       IssueHistory[]
  comments      Comment[]
  notifications Notification[]
  views         IssueView[]

  // D2: display identifier SHIP-{seqNumber}, unique per workspace, never reused.
  @@unique([workspaceId, seqNumber])
  @@index([workspaceId])
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([projectId])
  @@index([dueDate])
  @@index([blocked])
  @@index([archivedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, projectId])
  @@index([cycleId])
  @@index([workspaceId, cycleId])
  // F10: GIN over the generated vector — ranked-match hot path. Name is
  // pinned (map) to match the raw-SQL migration exactly.
  @@index([search_tsv], type: Gin, map: "issue_search_gin")
  @@map("issue")
}

// ── Cycles (F7) ────────────────────────────────────────────────────────────
// Prisma-owned (hand-modeled, like workspace/members/projects/issues). See
// shipyard-design/04-Engineering/features/cycles/data-model.md §2.

enum CycleStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Cycle {
  id          String      @id @default(cuid())
  workspaceId String
  name        String      @db.VarChar(120)
  goal        String?     @db.Text
  status      CycleStatus @default(PLANNED)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // F10 search (D2): generated tsvector column — see Issue.search_tsv.
  // A-weight = name.
  search_tsv  Unsupported("tsvector") @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, (COALESCE(name, ''::character varying))::text), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(goal, ''::text)), 'B'::\"char\"))"))

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    Issue[]

  // D3: case-insensitive, workspace-scoped name uniqueness is a raw SQL
  // functional index (cycle_name_unique) appended to the migration.
  // D5/D6: the no-overlap exclusion constraint (cycle_no_overlap) and the
  // single-active partial index (cycle_single_active) are raw SQL too —
  // Prisma cannot express either.
  @@index([workspaceId])
  @@index([status])
  @@index([archivedAt])
  @@index([workspaceId, status])
  @@index([search_tsv], type: Gin, map: "cycle_search_gin")
  @@map("cycle")
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String   @db.VarChar(60)
  color       String   @db.VarChar(7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]

  // D6: case-insensitive, workspace-scoped name uniqueness is a raw SQL
  // functional index (label_name_unique) appended to the migration.
  @@index([workspaceId])
  @@map("label")
}

// ── Comments + mentions (F8) ───────────────────────────────────────────────
// Prisma-owned (hand-modeled, like workspace/members/projects/issues/cycles).
// See shipyard-design/04-Engineering/features/comments/data-model.md §2.

model Comment {
  id          String    @id @default(cuid())
  workspaceId String
  issueId     String
  authorId    String
  content     String    @db.Text
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // F10 search (D2): generated tsvector column — see Issue.search_tsv.
  // Single B-weight (no title field exists).
  search_tsv  Unsupported("tsvector") @default(dbgenerated("setweight(to_tsvector('english'::regconfig, COALESCE(content, ''::text)), 'B'::\"char\")"))

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue     Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User             @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: Restrict)
  mentions  CommentMention[]
  notifications Notification[]

  @@index([workspaceId])
  @@index([issueId])
  @@index([authorId])
  @@index([issueId, createdAt])
  @@index([search_tsv], type: Gin, map: "comment_search_gin")
  @@map("comment")
}

model CommentMention {
  commentId       String
  mentionedUserId String
  createdAt       DateTime @default(now())

  comment       Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User    @relation("CommentMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@id([commentId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("comment_mention")
}

// ── Notifications (F6) ─────────────────────────────────────────────────────
// Prisma-owned (hand-modeled, like workspace/members/projects/issues/cycles/
// comments). See shipyard-design/04-Engineering/features/notifications/
// data-model.md §2.

enum NotificationType {
  ASSIGNMENT
  MENTION
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  recipientId String
  actorId     String?
  issueId     String
  commentId   String?
  type        NotificationType
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient User      @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?     @relation("SentNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // D7: the unread badge poll is served by the raw-SQL partial index
  // notification_unread_idx appended to the migration (Prisma cannot
  // express partial indexes).
  @@index([workspaceId])
  @@index([recipientId])
  @@index([recipientId, createdAt])
  @@index([issueId])
  @@index([commentId])
  @@map("notification")
}

// ── Activity Log ─────────────────────────────────────────────────────────
// Prisma-owned (hand-modeled, like all prior features). See
// shipyard-design/04-Engineering/features/activity/data-model.md §2.
//
// Inverse of notifications: rows OUTLIVE their source (a deleted entity's
// story is the point). Targets are plain strings, never FKs (D3) — deleting
// an issue/project/cycle/comment/invitation touches zero log rows.

enum ActivityKind {
  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  WORKSPACE_ARCHIVED
  WORKSPACE_RESTORED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_DECLINED
  MEMBER_INVITE_REVOKED
  MEMBER_REMOVED
  MEMBER_LEFT
  MEMBER_ROLE_CHANGED
  OWNERSHIP_TRANSFERRED
  PROJECT_CREATED
  PROJECT_RENAMED
  PROJECT_STATUS_CHANGED
  PROJECT_OWNER_TRANSFERRED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  PROJECT_DELETED
  ISSUE_CREATED
  ISSUE_STATUS_CHANGED
  ISSUE_ASSIGNED
  ISSUE_BLOCKED_SET
  ISSUE_BLOCKED_CLEARED
  ISSUE_ARCHIVED
  ISSUE_RESTORED
  ISSUE_DELETED
  COMMENT_CREATED
  COMMENT_DELETED
  CYCLE_CREATED
  CYCLE_STARTED
  CYCLE_COMPLETED
  CYCLE_REOPENED
  CYCLE_ARCHIVED
  CYCLE_RESTORED
  CYCLE_DELETED
}

enum ActivityEntityType {
  WORKSPACE
  MEMBER
  INVITATION
  PROJECT
  ISSUE
  COMMENT
  CYCLE
}

model ActivityEvent {
  id          String             @id @default(cuid())
  workspaceId String
  actorId     String?
  actorName   String             @db.VarChar(255)
  kind        ActivityKind
  entityType  ActivityEntityType
  entityId    String?
  entityTitle String?            @db.Text
  summary     String             @db.Text
  createdAt   DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([kind])
  @@index([actorId])
  @@map("activity_event")
}

model IssueLabel {
  issueId   String
  labelId   String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_label")
}

model IssueHistory {
  id          String            @id @default(cuid())
  workspaceId String
  issueId     String
  actorId     String?
  event       IssueHistoryEvent
  oldValue    String?           @db.Text
  newValue    String?           @db.Text
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([issueId])
  @@index([actorId])
  @@index([issueId, createdAt])
  @@map("issue_history")
}

model WorkspaceIssueSequence {
  workspaceId String @id
  nextNumber  Int    @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_issue_sequence")
}

model ViewPreference {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  scope       ViewScope
  view        ViewType  @default(LIST)
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // one preference per user per workspace per entity (rule 12 independence)
  @@unique([workspaceId, userId, scope])
  @@index([workspaceId])
  @@map("view_preference")
}

// ── Dashboard (F9) ───────────────────────────────────────────────────────────
// Prisma-owned (hand-modeled, like workspace/members/projects/issues). See
// shipyard-design/04-Engineering/features/dashboard/data-model.md §2. The only
// new table in F9 — every dashboard panel is derived at read time from owning
// modules' tables (D1); this stores just the personal recently-viewed trail.
//
// D2: @@id([userId, issueId]) makes "one entry per (user, issue)" structural —
// revisits upsert (bump viewedAt), never duplicate. The cap (50 per user per
// workspace, oldest-first pruning) is a service rule enforced in the recording
// tx, not a constraint.

model IssueView {
  userId      String
  issueId     String
  workspaceId String
  // Explicit writes (not @updatedAt) so creation and bump share one code
  // path: the upsert sets viewedAt = now() on every view. Recency position —
  // the trail's primary order (data-model §2.1).
  viewedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, issueId])
  @@index([userId])
  // Serves both the top-N trail read (ORDER viewedAt DESC LIMIT 10) and the
  // prune past 50 oldest on one index.
  @@index([userId, workspaceId, viewedAt])
  @@map("issue_view")
}

// ── Settings (F11) ───────────────────────────────────────────────────────────
// Prisma-owned (hand-modeled, like all prior features). See
// shipyard-design/04-Engineering/features/settings/data-model.md §2. The only
// new table in F11 — zero edits to Better Auth's generated tables (D1 keeps
// F11's footprint isolated and gives future prefs like locale an obvious home).
//
// D1: a dedicated table, not a `user` column. One row per user, created
// lazily on first preference write (upsert) — no backfill, no seed. Absent
// row reads as SYSTEM at read time (D6), same absent-means-default discipline
// as view_preference's LIST. Account-wide by construction: no workspaceId —
// theme follows the human (spec rule 2); view prefs stay per (user,
// workspace, kind) in F4's ViewPreference, untouched here.

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model UserPreference {
  // PK = userId — "one pref row per account" is structural, not conventional.
  userId    String          @id
  theme     ThemePreference @default(SYSTEM)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Prefs die with the account (private data, same reasoning as the
  // notification inbox).
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}
