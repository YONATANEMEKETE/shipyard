# Web app environment. Copy to `.env.local` for local development; Vercel
# holds the production values. Only `NEXT_PUBLIC_*` variables reach the
# browser bundle — both of these are inlined at build time, so changing either
# requires a rebuild.

# API origin. Every relative `/api/v1/…` path resolves against it.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Error monitoring (optional). Empty keeps the reporter off entirely. A DSN is
# write-only — it can submit events, never read anything back — so it is safe
# in the browser bundle. The Vercel project additionally carries SENTRY_ORG,
# SENTRY_PROJECT and SENTRY_AUTH_TOKEN (build-time, for source-map upload).
NEXT_PUBLIC_SENTRY_DSN=
